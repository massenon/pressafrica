# Local development. For the server, start from .env.production.example (docs/DEPLOY.md).
APP_NAME="Africa Global Press"
# Production values (owner's cPanel host). For local development set APP_ENV=local, APP_DEBUG=false.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
# Missing French strings (e.g. validation) fall back to the framework English, not to the raw key.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Session cookie sent over HTTPS only (HttpOnly is on by default).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Owner's mail server (2026-10-29). The password is set on the server only, never in this file.
# Local development: MAIL_MAILER=log writes e-mails to storage/logs instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=mail.pressafrica.media
MAIL_PORT=587
MAIL_USERNAME=contact@pressafrica.media
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@pressafrica.media"
MAIL_FROM_NAME="${APP_NAME}"
# Destinataire du support de l'editeur.
SUPPORT_MAIL=rarhodes06@gmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Password of the demo staff accounts created by db:seed outside production (random and printed if empty).
DEMO_PASSWORD=
